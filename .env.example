# UNIRISE Environment Variables Template
# Copy this file to .env.local for local testing
# NEVER commit real credentials or private keys to repository version control.

# Supabase Local & Remote Configuration
SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY="your-supabase-anon-key-placeholder"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-placeholder"

# AI Gateway API Configuration
GEMINI_API_KEY="your-gemini-api-key-placeholder"

# App Environment Configuration
ENVIRONMENT="development"
